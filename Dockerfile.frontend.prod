# syntax=docker/dockerfile:1
#
# Production-grade frontend image.
#
# Unlike Dockerfile.frontend (root nginx, used for E2E), this serves the built
# SPA from the non-root `nginxinc/nginx-unprivileged` image, which runs as an
# unprivileged user and listens on 8080 (no root-owned :80 bind). See #1340.

# ---------------------------------------------------------------------------
# Stage 1: Build the static frontend bundle
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/*/package.json ./packages/
COPY frontend/package.json ./frontend/
RUN pnpm install --frozen-lockfile

COPY packages ./packages
COPY frontend ./frontend
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "./packages/*" -r --workspace-concurrency=1 run build

# Build-time Vite configuration (single canonical API base URL, see #1334)
ARG VITE_API_BASE_URL=/api
ARG VITE_API_GATEWAY_URL=/api
ARG VITE_API_URL=/api
ARG VITE_NOTIFICATION_SERVICE_URL=

RUN cd frontend && \
    VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_API_GATEWAY_URL=${VITE_API_GATEWAY_URL} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_NOTIFICATION_SERVICE_URL=${VITE_NOTIFICATION_SERVICE_URL} \
    pnpm run build && \
    test -f /app/frontend/dist/index.html || (echo "ERROR: frontend/dist/index.html not found!" && exit 1)

# ---------------------------------------------------------------------------
# Stage 2: Serve with non-root nginx (listens on 8080)
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.29-alpine

# Temporarily switch to root only to install curl and lay down config/assets
USER root
RUN apk add --no-cache curl

# Reuse the shared nginx config, rewriting the listen directive to the
# unprivileged port 8080 (the unprivileged image cannot bind :80).
COPY frontend/nginx/default.conf /etc/nginx/conf.d/default.conf
RUN sed -i 's/listen 80;/listen 8080;/' /etc/nginx/conf.d/default.conf

COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Drop back to the unprivileged nginx user for runtime
USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
