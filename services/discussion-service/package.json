{
  "name": "@reason-bridge/discussion-service",
  "version": "0.1.0",
  "description": "Discussion service with NestJS and Prisma",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "dev": "SKIP_SWAGGER=1 tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@nestjs/cache-manager": "3.1.3",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@reason-bridge/common": "workspace:*",
    "@reason-bridge/db-models": "workspace:*",
    "@reason-bridge/event-schemas": "workspace:*",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "cache-manager": "7.2.9",
    "cache-manager-redis-store": "3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.10.0",
    "jwks-rsa": "4.1.0",
    "open-graph-scraper": "6",
    "pdfkit": "0.19.1",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "redis": "^6",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.27",
    "@pact-foundation/pact": "^17.0.1",
    "@reason-bridge/testing-utils": "workspace:*",
    "@types/node": "25.5.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "author": "Tony Stein"
}
