exports[`Common Ground Prompts > generateClarification prompt > generates correct system prompt for clarification 1`] = `"You are a mediator helping clarify misunderstandings. Provide a concise clarification that addresses different interpretations."`;

exports[`Common Ground Prompts > generateClarification prompt > generates correct user prompt for clarification 1`] = `
"Topic: "Universal Basic Income"

Different interpretations:
1. UBI means free money for everyone
2. UBI is a replacement for existing welfare
3. UBI is meant to supplement existing programs

Provide a brief clarification (2-3 sentences max) that addresses the core misunderstanding."
`;

exports[`Common Ground Prompts > identifyValues prompt > generates correct system prompt for value identification 1`] = `
