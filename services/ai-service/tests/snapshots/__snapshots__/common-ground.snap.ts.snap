exports[`Common Ground Prompts > clusterTexts prompt > generates correct system prompt for clustering 1`] = `
"You are an expert at semantic clustering. Group similar texts by meaning.
Return ONLY a JSON array of clusters in this exact format:
[{"theme": "description", "members": [1, 2, 3]}]
where members are the numeric IDs of the texts."
`;

exports[`Common Ground Prompts > clusterTexts prompt > generates correct user prompt for clustering 1`] = `
