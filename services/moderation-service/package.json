{
  "name": "@reason-bridge/moderation-service",
  "version": "0.1.0",
  "description": "Moderation service for content review and policy enforcement",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.3",
    "@nestjs/jwt": "11.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-fastify": "^11.1.18",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/schedule": "^6.1.1",
    "axios": "^1.14.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "7.6.0",
    "@reason-bridge/common": "workspace:*",
    "@reason-bridge/db-models": "workspace:*",
    "@reason-bridge/event-schemas": "workspace:*",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "fastify": "^5.8.4",
    "jwks-rsa": "4.0.1",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@pact-foundation/pact": "^16.3.0",
    "@types/node": "25.5.2",
    "@types/pg": "^8.20.0",
    "@vitest/ui": "^4.1.2",
    "tsx": "^4.7.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "author": "Tony Stein"
}
