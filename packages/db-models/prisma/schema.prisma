/// Authentication method used for user signup
enum AuthMethod {
  EMAIL_PASSWORD
  GOOGLE_OAUTH
  APPLE_OAUTH

  @@map("auth_method")
}

/// Onboarding step progression
enum OnboardingStep {
  VERIFICATION
  TOPICS
  ORIENTATION
  COMPLETE

  @@map("onboarding_step")
}

/// Topic activity level for selection guidance
enum ActivityLevel {
  HIGH
  MEDIUM
  LOW

  @@map("activity_level")
}

/// Account status for user management
enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("account_status")
