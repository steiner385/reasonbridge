// ============================================================================
// CHILD SAFETY ENTITIES (Feature: Child-Friendly Mode)
// ============================================================================

/// Parent consent status for minor users
enum ParentConsentStatus {
  NOT_REQUIRED // Adult user (age >= regional consent age)
  PENDING // Minor awaiting parent verification
  VERIFIED // Parent has consented
  WITHDRAWN // Parent withdrew consent

  @@map("parent_consent_status")
}

/// Parental consent record for minor users
model ParentalConsent {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  parentEmail    String    @map("parent_email")
  consentToken   String    @unique @map("consent_token")
  tokenExpiresAt DateTime  @map("token_expires_at")
  verifiedAt     DateTime? @map("verified_at")
  ipAddress      String?   @map("ip_address")
  withdrawnAt    DateTime? @map("withdrawn_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([consentToken])
  @@index([parentEmail])
  @@index([tokenExpiresAt])
  @@map("parental_consents")
}

/// Token types for verification flows
enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_token_type")
}

/// Email verification token for signup flow and password reset
/// Includes brute force protection via attempts tracking
model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  token     String                @unique @db.VarChar(6)
  type      VerificationTokenType @default(EMAIL_VERIFICATION)
  createdAt DateTime              @default(now()) @map("created_at")
  expiresAt DateTime              @map("expires_at")
  used      Boolean               @default(false)
  usedAt    DateTime?             @map("used_at")
  /// Number of failed verification attempts (brute force protection)
  attempts  Int                   @default(0)
  /// Timestamp when token was locked due to max failed attempts
  lockedAt  DateTime?             @map("locked_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([type])
  @@map("verification_tokens")
}

/// Tracks user progress through onboarding steps
model OnboardingProgress {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @unique @map("user_id") @db.Uuid
  emailVerified     Boolean        @default(false) @map("email_verified")
  topicsSelected    Boolean        @default(false) @map("topics_selected")
  orientationViewed Boolean        @default(false) @map("orientation_viewed")
  firstPostMade     Boolean        @default(false) @map("first_post_made")
  currentStep       OnboardingStep @map("current_step")
  lastUpdatedAt     DateTime       @updatedAt @map("last_updated_at")
  completedAt       DateTime?      @map("completed_at")

  @@index([currentStep])
  @@index([completedAt])
  @@map("onboarding_progress")
}

/// User's selected topic interests for personalization
model TopicInterest {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  topicId    String   @map("topic_id") @db.Uuid
  priority   Int      @db.SmallInt
  selectedAt DateTime @default(now()) @map("selected_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic DiscussionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, priority])
  @@map("topic_interests")
}

/// Pre-authentication visitor session tracking for demo
model VisitorSession {
  id                      String     @id @default(uuid()) @db.Uuid
  sessionId               String     @unique @map("session_id")
  viewedDemoDiscussionIds String[]   @default([]) @map("viewed_demo_discussion_ids") @db.Uuid
  interactionTimestamps   DateTime[] @default([]) @map("interaction_timestamps")
  referralSource          String?    @map("referral_source")
  convertedToUserId       String?    @unique @map("converted_to_user_id") @db.Uuid
  createdAt               DateTime   @default(now()) @map("created_at")
  lastActivityAt          DateTime   @updatedAt @map("last_activity_at")

  @@index([convertedToUserId])
  @@index([lastActivityAt])
  @@map("visitor_sessions")
}

// ============================================================================
// ACTIVITY SERVICE ENTITIES
// ============================================================================

/// Activity events for feed generation
/// Denormalized table capturing user activities for efficient feed queries
model ActivityEvent {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  activityType ActivityType @map("activity_type")

  // Target entity reference
  targetId   String     @map("target_id") @db.Uuid
  targetType TargetType @map("target_type")

  /// Denormalized title from target entity for display (copy, not updated if source changes)
  /// Activity events are immutable - no updatedAt field by design
  targetTitle String? @map("target_title") @db.VarChar(200)
  /// Denormalized slug from target entity for URL generation
  targetSlug  String? @map("target_slug") @db.VarChar(250)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("activity_events")
}

/// Types of activity events
enum ActivityType {
  TOPIC_CREATED
  RESPONSE_POSTED
  DISCUSSION_JOINED
  AI_SUGGESTION_ACCEPTED

  @@map("activity_type")
}

/// Target entity types for activity events
enum TargetType {
  TOPIC
  RESPONSE
  DISCUSSION

  @@map("target_type")
}

// ============================================================================
// COMPLIANCE AUDIT ENTITIES (Feature: Child-Friendly Mode)
// ============================================================================

/// Status of a data deletion request
enum DeletionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED

  @@map("deletion_status")
}

/// Status of child content review in moderation queue
enum ChildReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  ESCALATED

  @@map("child_review_status")
}

/// Priority level for child content review
enum ReviewPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("review_priority")
}

/// Data deletion request for COPPA/GDPR compliance
/// Created when parental consent is withdrawn or user requests account deletion
model DataDeletionRequest {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @unique @map("user_id") @db.Uuid
  requestedBy  String         @map("requested_by") @db.VarChar(20) // PARENT, USER, SYSTEM
  requestedAt  DateTime       @default(now()) @map("requested_at")
  scheduledFor DateTime       @map("scheduled_for") // requestedAt + 48 hours
  completedAt  DateTime?      @map("completed_at")
  status       DeletionStatus @default(PENDING)
  deletionLog  Json?          @map("deletion_log")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@map("data_deletion_requests")
}

/// Queue for moderating content created by child users before publication
model ChildContentReviewQueue {
  id              String            @id @default(uuid()) @db.Uuid
  responseId      String            @unique @map("response_id") @db.Uuid
  topicId         String            @map("topic_id") @db.Uuid
  authorId        String            @map("author_id") @db.Uuid
  content         String            @db.Text
  status          ChildReviewStatus @default(PENDING)
  priority        ReviewPriority    @default(NORMAL)
  aiFlags         Json?             @map("ai_flags")
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at")
  decision        String?           @db.VarChar(20)
  rejectionReason String?           @map("rejection_reason") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  response Response        @relation(fields: [responseId], references: [id], onDelete: Cascade)
  topic    DiscussionTopic @relation(fields: [topicId], references: [id])
  author   User            @relation("ChildContentAuthor", fields: [authorId], references: [id])
  reviewer User?           @relation("ChildContentReviewer", fields: [reviewedById], references: [id])

  @@index([status, priority, createdAt])
  @@index([topicId])
  @@index([authorId])
  @@map("child_content_review_queue")
}

/// Compliance action types for audit logging
enum ComplianceAction {
  AGE_VERIFIED
  CONSENT_REQUESTED
  CONSENT_VERIFIED
  CONSENT_WITHDRAWN
  DATA_DELETION_REQUESTED
  DATA_DELETION_COMPLETED
  ANNUAL_REVERIFICATION

  @@map("compliance_action")
}

/// Audit log for regulatory compliance (COPPA, GDPR, AADC)
/// Tracks all compliance-related actions for audit and reporting purposes
model ComplianceAuditLog {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @map("user_id") @db.Uuid
  action ComplianceAction

  /// JSON metadata containing contextual information about the compliance action.
  /// Expected structure: { region: string, consentAge: number, ipAddress: string, userAgent: string }
  /// Additional fields may be present depending on the action type.
  metadata Json

  /// Immutable timestamp of when the action occurred. Never update this field.
  timestamp DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action, timestamp])
  @@map("compliance_audit_logs")
}

/// Reason types for child safety reports
enum SafetyReportReason {
  UNCOMFORTABLE // General discomfort
  SCARY_CONTENT // Saw something scary
  STRANGER_CONTACT // Someone unknown contacted me
  PERSONAL_QUESTIONS // Asked personal questions
  OTHER // Other reason

  @@map("safety_report_reason")
}

/// Status of a safety report
enum SafetyReportStatus {
  PENDING // Awaiting moderator review
  UNDER_REVIEW // Being actively investigated
  RESOLVED // Issue has been addressed
  ESCALATED // Escalated to higher authority

  @@map("safety_report_status")
}

/// Safety reports from minor users
/// Stores concerns reported via the Panic Button feature
model SafetyReport {
  id                String             @id @default(uuid()) @db.Uuid
  reporterId        String             @map("reporter_id") @db.Uuid
  reason            SafetyReportReason
  additionalInfo    String?            @map("additional_info") @db.Text
  status            SafetyReportStatus @default(PENDING)
  priority          ReviewPriority     @default(NORMAL)
  /// Optional context: current page URL when report was made
  contextUrl        String?            @map("context_url") @db.VarChar(500)
  /// Optional context: topic ID if report was made while viewing a topic
  contextTopicId    String?            @map("context_topic_id") @db.Uuid
  /// Optional context: response ID if report was about a specific response
  contextResponseId String?            @map("context_response_id") @db.Uuid
  /// Moderator notes
  moderatorNotes    String?            @map("moderator_notes") @db.Text
  /// ID of moderator who handled the report
  handledById       String?            @map("handled_by_id") @db.Uuid
  handledAt         DateTime?          @map("handled_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  reporter User  @relation("SafetyReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handler  User? @relation("SafetyReportHandler", fields: [handledById], references: [id])

  @@index([reporterId])
  @@index([status, priority, createdAt])
  @@index([contextTopicId])
  @@map("safety_reports")
}

/// Detection source for CSAM content
enum CsamDetectionSource {
  AI_DETECTION // Detected by AI content screening
  USER_REPORT // Reported by platform user
  MODERATOR_REVIEW // Found during moderation review
  HASH_MATCH // Matched known CSAM hash (PhotoDNA, etc.)

  @@map("csam_detection_source")
}

/// Status of CSAM report to NCMEC
enum CsamReportStatus {
  PENDING_REVIEW // Awaiting internal review
  EVIDENCE_PRESERVED // Evidence has been preserved
  SUBMITTED_NCMEC // Submitted to NCMEC CyberTipline
  CONFIRMED // NCMEC confirmed receipt
  REJECTED // Internal review determined not CSAM

  @@map("csam_report_status")
}

/// CSAM (Child Sexual Abuse Material) reports for NCMEC CyberTipline
/// Mandatory reporting within 24 hours as required by 18 U.S.C. § 2258A
model CsamReport {
  id                String              @id @default(uuid()) @db.Uuid
  /// Source of detection
  detectionSource   CsamDetectionSource @map("detection_source")
  /// Current status of the report
  status            CsamReportStatus    @default(PENDING_REVIEW)
  /// ID of the content (response, topic, etc.) that triggered the report
  contentType       String              @map("content_type") @db.VarChar(50)
  contentId         String              @map("content_id") @db.Uuid
  /// User who created the flagged content (may be null if anonymous)
  contentAuthorId   String?             @map("content_author_id") @db.Uuid
  /// S3 path to preserved evidence (encrypted)
  evidenceS3Key     String?             @map("evidence_s3_key") @db.VarChar(500)
  /// Hash of preserved content for integrity verification
  evidenceHash      String?             @map("evidence_hash") @db.VarChar(128)
  /// NCMEC CyberTipline report ID (assigned after submission)
  ncmecReportId     String?             @map("ncmec_report_id") @db.VarChar(50)
  /// Timestamp when submitted to NCMEC
  ncmecSubmittedAt  DateTime?           @map("ncmec_submitted_at")
  /// Internal notes (for legal/compliance team only)
  internalNotes     String?             @map("internal_notes") @db.Text
  /// Legal hold flag - prevents deletion of related data
  isLegalHold       Boolean             @default(true) @map("is_legal_hold")
  /// User ID who flagged/reported (if user-initiated)
  reportedById      String?             @map("reported_by_id") @db.Uuid
  /// AI confidence score if AI-detected (0.0-1.0)
  aiConfidenceScore Decimal?            @map("ai_confidence_score") @db.Decimal(3, 2)
  /// PhotoDNA or similar hash match details
  hashMatchDetails  Json?               @map("hash_match_details")
  /// Deadline for NCMEC submission (24 hours from detection)
  ncmecDeadline     DateTime            @map("ncmec_deadline")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([status, ncmecDeadline])
  @@index([contentType, contentId])
  @@index([ncmecReportId])
  @@index([isLegalHold])
  @@map("csam_reports")
}

// ============================================================================
// CONTACT SERVICE ENTITIES (Feature: Social Integration)
// ============================================================================

/// Social media provider for OAuth connections
enum SocialProvider {
  GOOGLE
  FACEBOOK

  @@map("social_provider")
}

/// Status of topic invitations
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED

  @@map("invitation_status")
}

/// OAuth connection to social media provider for contact import
model SocialConnection {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  provider       SocialProvider
  providerUserId String         @map("provider_user_id")
  accessToken    String         @map("access_token")
  refreshToken   String?        @map("refresh_token")
  tokenExpiry    DateTime?      @map("token_expiry")
  scopes         String[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@index([userId])
  @@map("social_connections")
}

/// Imported contact from social media provider
model ImportedContact {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @map("owner_id") @db.Uuid
  emailHash     String         @map("email_hash")
  displayName   String?        @map("display_name")
  provider      SocialProvider
  matchedUserId String?        @map("matched_user_id") @db.Uuid
  importedAt    DateTime       @default(now()) @map("imported_at")

  @@unique([ownerId, emailHash])
  @@index([emailHash])
  @@index([ownerId])
  @@map("imported_contacts")
}

/// Invitation to join a topic discussion
model TopicInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  topicId       String           @map("topic_id") @db.Uuid
  inviterId     String           @map("inviter_id") @db.Uuid
  inviteeUserId String?          @map("invitee_user_id") @db.Uuid
  inviteeEmail  String?          @map("invitee_email")
  status        InvitationStatus @default(PENDING)
  token         String           @unique
  message       String?
  createdAt     DateTime         @default(now()) @map("created_at")
  expiresAt     DateTime         @map("expires_at")
  respondedAt   DateTime?        @map("responded_at")

  @@index([inviteeUserId])
  @@index([inviteeEmail])
  @@index([topicId])
  @@index([token])
  @@map("topic_invitations")
}

/// Source of topic access grant
enum AccessSource {
  INVITATION   // Granted via accepted invitation
  DIRECT_GRANT // Granted directly by topic creator/moderator
  CREATOR      // Automatic access for topic creator

  @@map("access_source")
}

/// Explicit topic access grants for private/unlisted topics
/// Created when users are invited to private topics and accept
model TopicAccess {
  id        String   @id @default(uuid()) @db.Uuid
  topicId   String   @map("topic_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at")

  // Source of access grant
  source AccessSource @default(INVITATION)

  // Optional reference to the invitation that granted access
  invitationId String? @map("invitation_id") @db.Uuid

  @@unique([topicId, userId])
  @@index([userId])
  @@index([topicId])
  @@map("topic_access")
}

// ============================================================================
// NOTIFICATION SERVICE ENTITIES
// ============================================================================

/// Notification delivery channel
enum NotificationChannel {
  IN_APP // In-app notification (stored in database)
  EMAIL // Email notification
  PUSH // Push notification
  SMS // SMS notification
}

/// Notification delivery status
enum NotificationDeliveryStatus {
  PENDING // Queued for delivery
  SENT // Successfully sent
  DELIVERED // Confirmed delivered (for push/email)
  FAILED // Delivery failed
  BOUNCED // Email bounced
}

/// User notification - stores in-app notifications (Feature #1044, Task T198)
/// Type uses flexible string to support: mention, follow, common_ground,
/// moderation_action, trust_update, safety_report, etc.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50) // Flexible type: mention, follow, common_ground, etc.
  title     String    @db.VarChar(255)
  body      String    @db.Text
  actionUrl String?   @map("action_url") @db.VarChar(500)
  metadata  Json?     @db.JsonB
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs NotificationLog[]

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

/// Notification delivery log - tracks delivery attempts across channels
model NotificationLog {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String?                    @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  recipientEmail String?                    @map("recipient_email")
  recipientPhone String?                    @map("recipient_phone")
  externalId     String?                    @map("external_id") // Third-party delivery ID
  errorMessage   String?                    @map("error_message") @db.Text
  metadata       Json?                      @db.JsonB
  attemptedAt    DateTime                   @default(now()) @map("attempted_at")
  deliveredAt    DateTime?                  @map("delivered_at")

  // Relations
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([channel, status])
  @@index([attemptedAt])
  @@map("notification_logs")
}
