# Frontend Environment Configuration
# Copy this file to .env.local for local development.
#
# The app talks to the backend through a SINGLE canonical base URL. In local dev
# and production the frontend is served behind a proxy (Vite dev server or the
# nginx frontend container) that forwards "/api/*" to the API Gateway, so the
# default of "/api" works everywhere and needs no host/port.
#
# Only override this if the frontend is served WITHOUT that proxy and must reach
# the gateway directly (e.g. VITE_API_BASE_URL=http://localhost:3000).

# Canonical API base URL used by the shared apiClient (src/lib/api.ts) and the
# auth service (src/services/authService.ts). Leave as "/api" for the proxied
# setup used by `pnpm dev` and the Docker/nginx deployment.
VITE_API_BASE_URL=/api

# Legacy alias still read by some data services/hooks (e.g. topicService.ts).
# Keep it in sync with VITE_API_BASE_URL. Both default to "/api" in code when unset.
VITE_API_URL=/api

# Optional: base URL for the notification WebSocket service. Leave empty to use
# the same origin (proxied via "/socket.io").
VITE_NOTIFICATION_SERVICE_URL=
